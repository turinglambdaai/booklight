<Window
    x:Class="RivetHost.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <InfoBar
            x:Name="StatusBar"
            Grid.Row="0"
            IsOpen="False"
            IsClosable="False"
            Severity="Informational"
            Message="Starting…" />

        <!-- command bar -->
        <StackPanel
            Grid.Row="1"
            Orientation="Horizontal"
            Spacing="4"
            Padding="8,6">
            <Button
                x:Name="OpenButton"
                Click="Open_Click"
                ToolTipService.ToolTip="打开">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE8E5;" />
                    <TextBlock x:Name="OpenLabel" Text="打开 PDF" FontSize="12" />
                </StackPanel>
            </Button>
            <ToggleButton
                x:Name="LeftToggle"
                Click="LeftToggle_Click"
                ToolTipService.ToolTip="缩略图 / 目录">
                <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE700;" />
            </ToggleButton>
            <Button
                x:Name="RecentsButton"
                ToolTipService.ToolTip="最近打开">
                <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE823;" />
                <Button.Flyout>
                    <MenuFlyout x:Name="RecentsFlyout" Opening="RecentsFlyout_Opening" Placement="Bottom" />
                </Button.Flyout>
            </Button>
            <Button
                x:Name="FindToggle"
                Click="FindToggle_Click"
                ToolTipService.ToolTip="搜索">
                <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE721;" />
            </Button>
            <ToggleButton
                x:Name="BookmarkToggle"
                Click="Bookmark_Click"
                ToolTipService.ToolTip="书签当前页">
                <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE734;" />
            </ToggleButton>
            <ToggleButton
                x:Name="SplitToggle"
                Click="Split_Click"
                ToolTipService.ToolTip="分屏视图">
                <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE89A;" />
            </ToggleButton>
            <ToggleButton
                x:Name="TtsButton"
                Click="TtsButton_Click"
                ToolTipService.ToolTip="朗读本页">
                <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE720;" />
            </ToggleButton>
            <Button
                x:Name="PrintButton"
                Click="PrintButton_Click"
                ToolTipService.ToolTip="打印">
                <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE749;" />
            </Button>
            <!-- tools: watermark + exports (mac app-menu Tools section parity) -->
            <Button x:Name="ToolsButton" ToolTipService.ToolTip="工具">
                <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE90F;" />
                <Button.Flyout>
                    <MenuFlyout Placement="Bottom">
                        <MenuFlyoutItem x:Name="ToolsWatermarkItem" Click="ToolsWatermark_Click" />
                        <MenuFlyoutItem x:Name="ToolsExportPageItem" Click="ToolsExportPage_Click" />
                        <MenuFlyoutItem x:Name="ToolsExportTextItem" Click="ToolsExportText_Click" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
            <ToggleButton
                x:Name="AiToggle"
                Click="AiToggle_Click"
                ToolTipService.ToolTip="AI 助手">
                <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE99A;" />
            </ToggleButton>
            <Button
                x:Name="ThemeButton"
                Click="Theme_Click"
                ToolTipService.ToolTip="深色 / 浅色">
                <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE706;" />
            </Button>
        </StackPanel>

        <Grid Grid.Row="2" x:Name="MainArea">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- left panel: thumbnails / outline / notes / page ops -->
            <Grid
                Grid.Column="0"
                x:Name="LeftPanel"
                Width="232"
                Padding="8,4"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" x:Name="LeftTop" />

                <StackPanel
                    Grid.Row="1"
                    Orientation="Horizontal"
                    Spacing="4"
                    Margin="0,6,0,6"
                    x:Name="LeftModeRow">
                    <ToggleButton
                        x:Name="ThumbsMode"
                        Click="ThumbsMode_Click"
                        MinWidth="64">
                        <TextBlock x:Name="ThumbsModeLabel" Text="缩略图" FontSize="12" />
                    </ToggleButton>
                    <ToggleButton
                        x:Name="OutlineMode"
                        Click="OutlineMode_Click"
                        MinWidth="64">
                        <TextBlock x:Name="OutlineModeLabel" Text="目录" FontSize="12" />
                    </ToggleButton>
                    <ToggleButton
                        x:Name="NotesMode"
                        Click="NotesMode_Click"
                        MinWidth="64">
                        <TextBlock x:Name="NotesModeLabel" Text="批注" FontSize="12" />
                    </ToggleButton>
                </StackPanel>

                <ScrollViewer Grid.Row="2">
                    <StackPanel x:Name="LeftContent" Spacing="4" />
                </ScrollViewer>
            </Grid>

            <!-- center: tabs + welcome overlay + find bar -->
            <Grid Grid.Column="1" x:Name="CenterHost">
                <TabView
                    x:Name="DocTabs"
                    SelectionChanged="DocTabs_SelectionChanged"
                    TabCloseRequested="DocTabs_CloseRequested"
                    IsAddTabButtonVisible="False" />
                <!-- the shelf: Books-style launch surface (mac LibraryView parity) —
                     source-list sidebar over the home digest or a scope grid -->
                <Grid x:Name="ShelfView" Visibility="Visible">
                    <NavigationView
                        x:Name="ShelfNav"
                        PaneDisplayMode="Left"
                        OpenPaneLength="220"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        IsPaneToggleButtonVisible="False"
                        ItemInvoked="ShelfNav_ItemInvoked">
                        <!-- menu items are built in code: the collections section is dynamic -->
                        <Grid>
                            <!-- home digest: goals card (live seconds) + two rows -->
                            <ScrollViewer x:Name="HomePane">
                                <StackPanel Padding="32,16,32,32" Spacing="24">
                                    <TextBlock
                                        x:Name="HomeTitle"
                                        FontSize="34"
                                        FontWeight="Bold"
                                        Margin="0,12,0,0" />
                                    <Border
                                        x:Name="GoalsCard"
                                        CornerRadius="14"
                                        BorderThickness="1"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        MaxWidth="760"
                                        HorizontalAlignment="Left">
                                        <StackPanel>
                                            <Grid
                                                Width="280"
                                                Height="150"
                                                HorizontalAlignment="Center"
                                                Margin="0,8,0,12">
                                                <Path
                                                    x:Name="GoalTrackPath"
                                                    StrokeThickness="10"
                                                    StrokeStartLineCap="Round"
                                                    StrokeEndLineCap="Round" />
                                                <Path
                                                    x:Name="GoalProgressPath"
                                                    StrokeThickness="10"
                                                    StrokeStartLineCap="Round"
                                                    StrokeEndLineCap="Round"
                                                    Visibility="Collapsed" />
                                                <StackPanel
                                                    x:Name="GoalCenter"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Spacing="4"
                                                    Margin="0,14,0,0">
                                                    <TextBlock
                                                        x:Name="GoalTodayLabel"
                                                        FontSize="15"
                                                        FontWeight="SemiBold"
                                                        HorizontalAlignment="Center" />
                                                    <TextBlock
                                                        x:Name="GoalMmss"
                                                        FontSize="46"
                                                        FontWeight="Bold"
                                                        HorizontalAlignment="Center" />
                                                    <TextBlock
                                                        x:Name="GoalOfLabel"
                                                        FontSize="12"
                                                        Opacity="0.6"
                                                        HorizontalAlignment="Center" />
                                                    <Border
                                                        x:Name="GoalHitBadge"
                                                        CornerRadius="10"
                                                        Padding="8,2"
                                                        HorizontalAlignment="Center"
                                                        Visibility="Collapsed">
                                                        <TextBlock x:Name="GoalHitText" FontSize="11" FontWeight="SemiBold" />
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                            <!-- the Books store-button slot: opens the last-read book -->
                                            <Button
                                                x:Name="ContinuePill"
                                                Click="ContinuePill_Click"
                                                Padding="28,12"
                                                CornerRadius="20"
                                                HorizontalAlignment="Center"
                                                Margin="0,0,0,24"
                                                Visibility="Collapsed">
                                                <TextBlock x:Name="ContinuePillLabel" FontSize="15" FontWeight="SemiBold" />
                                            </Button>
                                            <Button
                                                x:Name="ContinuePillImport"
                                                Click="ContinuePillImport_Click"
                                                Style="{ThemeResource AccentButtonStyle}"
                                                HorizontalAlignment="Center"
                                                Margin="0,0,0,24"
                                                Visibility="Collapsed">
                                                <TextBlock x:Name="ContinuePillImportLabel" FontSize="15" FontWeight="SemiBold" />
                                            </Button>
                                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                            <StackPanel Margin="0,18">
                                                <StackPanel
                                                    x:Name="StreakRow"
                                                    Orientation="Horizontal"
                                                    Spacing="10"
                                                    HorizontalAlignment="Center" />
                                                <TextBlock
                                                    x:Name="StreakLabel"
                                                    FontSize="12"
                                                    Opacity="0.6"
                                                    HorizontalAlignment="Center"
                                                    Margin="0,8,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock
                                        x:Name="ContinueHeader"
                                        FontSize="17"
                                        FontWeight="SemiBold"
                                        Visibility="Collapsed" />
                                    <ScrollViewer
                                        x:Name="ContinueScroll"
                                        HorizontalAlignment="Left"
                                        HorizontalScrollBarVisibility="Auto"
                                        HorizontalScrollMode="Auto"
                                        VerticalScrollBarVisibility="Disabled"
                                        Visibility="Collapsed">
                                        <StackPanel x:Name="ContinueRow" Orientation="Horizontal" Spacing="22" Margin="0,4" />
                                    </ScrollViewer>
                                    <TextBlock
                                        x:Name="RecentHeader"
                                        FontSize="17"
                                        FontWeight="SemiBold"
                                        Visibility="Collapsed" />
                                    <ScrollViewer
                                        x:Name="RecentScroll"
                                        HorizontalAlignment="Left"
                                        HorizontalScrollBarVisibility="Auto"
                                        HorizontalScrollMode="Auto"
                                        VerticalScrollBarVisibility="Disabled"
                                        Visibility="Collapsed">
                                        <StackPanel x:Name="RecentRow" Orientation="Horizontal" Spacing="22" Margin="0,4" />
                                    </ScrollViewer>
                                </StackPanel>
                            </ScrollViewer>

                                <!-- scope grid: import / search / covers / empty state -->
                                <Grid x:Name="GridPane" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="16,8,0,4">
                                            <Button x:Name="ShelfImport" Click="ShelfImport_Click" Style="{ThemeResource AccentButtonStyle}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE710;" />
                                                    <TextBlock x:Name="ShelfImportLabel" FontSize="12" />
                                                </StackPanel>
                                            </Button>
                                            <TextBox
                                                x:Name="ShelfSearch"
                                                Width="190"
                                                TextChanged="ShelfSearch_TextChanged" />
                                            <ProgressRing x:Name="ShelfBusy" Width="18" Height="18" IsActive="False" />
                                        </StackPanel>
                                        <!-- the Books toolbar mini-gauge: today's minutes over the goal -->
                                        <Grid
                                            x:Name="TodayRing"
                                            Width="30"
                                            Height="30"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Margin="0,8,16,4">
                                            <Ellipse x:Name="TodayRingTrack" StrokeThickness="2.5" />
                                            <Path
                                                x:Name="TodayRingArc"
                                                StrokeThickness="2.5"
                                                StrokeStartLineCap="Round"
                                                StrokeEndLineCap="Round"
                                                Visibility="Collapsed" />
                                            <Ellipse
                                                x:Name="TodayRingFill"
                                                StrokeThickness="2.5"
                                                Visibility="Collapsed" />
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock x:Name="TodayRingMinutes" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" />
                                                <TextBlock x:Name="TodayRingGoal" FontSize="7" Opacity="0.5" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>

                                <GridView
                                    Grid.Row="1"
                                    x:Name="ShelfGrid"
                                    Padding="32,12,32,28"
                                    IsMultiSelectCheckBoxEnabled="False">
                                    <GridView.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <ItemsWrapGrid Orientation="Horizontal" ItemWidth="164" ItemHeight="272" />
                                        </ItemsPanelTemplate>
                                    </GridView.ItemsPanel>
                                </GridView>

                                <!-- empty shelf -->
                                <StackPanel
                                    Grid.Row="1"
                                    x:Name="ShelfEmpty"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="12"
                                    Visibility="Collapsed">
                                    <FontIcon
                                        x:Name="ShelfEmptyIcon"
                                        FontFamily="Segoe Fluent Icons"
                                        FontSize="44"
                                        Glyph="&#xE736;" />
                                    <TextBlock
                                        x:Name="ShelfEmptyTitle"
                                        FontSize="17"
                                        FontWeight="SemiBold"
                                        HorizontalAlignment="Center" />
                                    <TextBlock
                                        x:Name="ShelfEmptyHint"
                                        FontSize="13"
                                        Opacity="0.6"
                                        MaxWidth="360"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap"
                                        HorizontalAlignment="Center" />
                                    <Button
                                        x:Name="ShelfEmptyImport"
                                        Click="ShelfImport_Click"
                                        Style="{ThemeResource AccentButtonStyle}"
                                        HorizontalAlignment="Center"
                                        Margin="0,6,0,0">
                                        <TextBlock x:Name="ShelfEmptyImportLabel" FontSize="14" FontWeight="SemiBold" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </NavigationView>
                </Grid>
                <Border
                    x:Name="FindBar"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,8,0,0"
                    Padding="10,6"
                    CornerRadius="8"
                    Visibility="Collapsed"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontFamily="Segoe Fluent Icons" FontSize="13" Glyph="&#xE721;" />
                        <TextBox
                            x:Name="FindInput"
                            Width="200"
                            PlaceholderText="搜索"
                            TextChanged="FindInput_TextChanged"
                            KeyDown="FindInput_KeyDown" />
                        <TextBlock x:Name="FindCount" VerticalAlignment="Center" FontSize="11" Opacity="0.7" />
                        <Button x:Name="FindPrev" Click="FindPrev_Click" ToolTipService.ToolTip="上一个">
                            <FontIcon FontFamily="Segoe Fluent Icons" FontSize="12" Glyph="&#xE74A;" />
                        </Button>
                        <Button x:Name="FindNext" Click="FindNext_Click" ToolTipService.ToolTip="下一个">
                            <FontIcon FontFamily="Segoe Fluent Icons" FontSize="12" Glyph="&#xE74B;" />
                        </Button>
                        <Button x:Name="FindClose" Click="FindClose_Click" ToolTipService.ToolTip="关闭">
                            <FontIcon FontFamily="Segoe Fluent Icons" FontSize="12" Glyph="&#xE711;" />
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- AI sidebar -->
            <Grid
                Grid.Column="2"
                x:Name="AiPanel"
                Width="400"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="1,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="2" Padding="8,8,8,4" x:Name="AiTabRow" />

                <ScrollViewer Grid.Row="1">
                    <StackPanel x:Name="AiContent" Spacing="8" Padding="8,0,8,8" />
                </ScrollViewer>

                <Grid Grid.Row="2" x:Name="ChatInputBar" Visibility="Collapsed" Padding="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="ChatInput"
                        Grid.Column="0"
                        PlaceholderText="基于文档内容提问…"
                        KeyDown="ChatInput_KeyDown" />
                    <Button x:Name="ChatSend" Grid.Column="1" Click="SendChat_Click" Margin="6,0,0,0">
                        <TextBlock x:Name="ChatSendLabel" Text="发送" />
                    </Button>
                    <Button x:Name="ChatStop" Grid.Column="2" Click="StopChat_Click" Margin="6,0,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="ChatStopLabel" Text="停止" />
                    </Button>
                </Grid>
            </Grid>
        </Grid>

        <!-- bottom bar -->
        <Grid Grid.Row="3" x:Name="BottomBar" Visibility="Collapsed" Padding="12,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="PageInput"
                Grid.Column="0"
                Width="48"
                Text="1"
                TextAlignment="Center"
                KeyDown="PageInput_KeyDown" />
            <TextBlock x:Name="PageTotal" Grid.Column="1" Text=" / 0" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="12" Opacity="0.7" />
            <TextBlock x:Name="PageInfo" Grid.Column="2" Text="" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12" Opacity="0.5" />
            <Button x:Name="ZoomOut" Grid.Column="4" Click="ZoomOut_Click" ToolTipService.ToolTip="缩小">
                <FontIcon FontFamily="Segoe Fluent Icons" FontSize="12" Glyph="&#xE71F;" />
            </Button>
            <Button x:Name="ZoomReset" Grid.Column="5" Click="ZoomReset_Click" ToolTipService.ToolTip="重置缩放">
                <TextBlock x:Name="ScaleLabel" Text="100%" FontSize="12" />
            </Button>
            <Button x:Name="ZoomIn" Grid.Column="6" Click="ZoomIn_Click" ToolTipService.ToolTip="放大">
                <FontIcon FontFamily="Segoe Fluent Icons" FontSize="12" Glyph="&#xE8A3;" />
            </Button>
            <Button x:Name="FitWidth" Grid.Column="7" Click="FitWidth_Click" Margin="8,0,0,0">
                <TextBlock x:Name="FitWidthLabel" Text="适应宽度" FontSize="12" />
            </Button>
        </Grid>
    </Grid>
</Window>
